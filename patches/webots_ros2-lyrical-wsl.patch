diff --git a/webots_ros2_driver/CMakeLists.txt b/webots_ros2_driver/CMakeLists.txt
index 693d9ed..ac80e15 100644
--- a/webots_ros2_driver/CMakeLists.txt
+++ b/webots_ros2_driver/CMakeLists.txt
@@ -10,10 +10,26 @@ if($ENV{ROS_DISTRO} MATCHES "humble")
   add_compile_definitions(HUMBLE)
 elseif($ENV{ROS_DISTRO} MATCHES "jazzy")
   add_compile_definitions(JAZZY)
-elseif($ENV{ROS_DISTRO} MATCHES "rolling")
+elseif($ENV{ROS_DISTRO} MATCHES "rolling|lyrical")
   add_compile_definitions(ROLLING)
 endif()
 
+# ament_target_dependencies was removed in ROS 2 Lyrical: minimal shim
+if(NOT COMMAND ament_target_dependencies)
+  macro(ament_target_dependencies target)
+    foreach(_dep ${ARGN})
+      if(DEFINED ${_dep}_TARGETS)
+        target_link_libraries(${target} ${${_dep}_TARGETS})
+      elseif(TARGET ${_dep}::${_dep})
+        target_link_libraries(${target} ${_dep}::${_dep})
+      else()
+        target_include_directories(${target} PUBLIC ${${_dep}_INCLUDE_DIRS})
+        target_link_libraries(${target} ${${_dep}_LIBRARIES})
+      endif()
+    endforeach()
+  endmacro()
+endif()
+
 # ROS2 Packages
 find_package(ament_cmake REQUIRED)
 find_package(ament_cmake_python REQUIRED)
@@ -38,6 +54,8 @@ elseif($ENV{ROS_DISTRO} MATCHES "jazzy")
   find_package(Python 3.12 EXACT REQUIRED COMPONENTS Development)
 elseif($ENV{ROS_DISTRO} MATCHES "rolling")
   find_package(Python 3.12 EXACT REQUIRED COMPONENTS Development)
+else()
+  find_package(Python 3 REQUIRED COMPONENTS Development)
 endif()
 
 add_custom_target(compile-lib-controller ALL
